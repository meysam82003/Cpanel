{
  "name": "ghajar/telegram-cpanel-manager",
  "description": "Multi-tenant Telegram bot and Mini App for secure cPanel administration",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-zlib": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@lint",
      "@test:static",
      "phpunit --colors=always"
    ],
    "test:unit": "phpunit --testsuite unit --colors=always",
    "test:integration": "phpunit --testsuite integration --colors=always",
    "test:security": "phpunit --testsuite security --colors=always",
    "test:static": "node scripts/verify-static.mjs",
    "test:cpanel-contract": "node scripts/verify-cpanel-openapi.mjs",
    "lint": "@php scripts/lint.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {}
  }
}
