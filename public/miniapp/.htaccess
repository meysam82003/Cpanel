# Mini App assets: always revalidate so Telegram's WebView never keeps an old
# release (entry points are additionally versioned with ?v=).
<IfModule mod_headers.c>
    <FilesMatch "\.(?:js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType text/css .css
</IfModule>
